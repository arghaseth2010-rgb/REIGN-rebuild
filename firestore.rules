rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Every document lives under users/{uid}/... — only that signed-in
    // user (or the Admin SDK used by Cloud Functions, which bypasses
    // rules entirely) can read or write it.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
